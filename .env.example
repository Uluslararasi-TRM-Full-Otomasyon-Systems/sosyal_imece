# Sosyal İmece - API Key Config (.env.example)
# Bu dosyayı .env olarak kopyalayın ve gerçek API key'lerinizi girin

# ============================================
# LLM / AI API Keys
# ============================================
OPENROUTER_API_KEY=sk-or-v1-your-actual-openrouter-key-here
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=gsk_your-groq-api-key-here

# ============================================
# Sosyal Medya API Keys
# ============================================
YOUTUBE_API_KEY=AIzaSy-your-youtube-api-key-here
TIKTOK_API_KEY=your-tiktok-api-key-here
INSTAGRAM_ACCESS_TOKEN=your-instagram-long-lived-access-token
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_TOKEN_SECRET=your-twitter-access-token-secret

# ============================================
# WhatsApp Business API
# ============================================
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token

# ============================================
# Telegram Bot API
# ============================================
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-botfather

# ============================================
# Facebook Graph API
# ============================================
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_ACCESS_TOKEN=your-facebook-access-token

# ============================================
# System Config
# ============================================
FLASK_SECRET_KEY=your-random-secret-key-for-flask-sessions
FLASK_DEBUG=false
PORT=5000
CEO_ACCESS_KEY=change-me-strong-ceo-key
CEO_API_KEY=change-me-same-or-separate-from-ceo-access-key

# ============================================
# Telegram (user API / dinleyici)
# ============================================
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_CHAT_ID=

# ============================================
# Diğer entegrasyonlar
# ============================================
OPENAI_API_KEY=
CLAUDE_API_KEY=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_WEBHOOK_URL=
GOOGLE_DRIVE_FOLDER_ID=
FACEBOOK_PAGE_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
TIKTOK_ACCESS_TOKEN=
YOUTUBE_CHANNEL_ID=
TRM_MODE=live
TRM_PUBLIC_DOMAIN=kureselimecedunyasi.org.tr
